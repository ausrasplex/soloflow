// SoloFlow data model (docs/SPEC.md, "Data model"). Money is exact decimal.
// Removable records carry deletedAt / deletedById / deleteReason and are hidden, never hard-deleted.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  EDITOR
  VIEWER
}



model User {
  id            String         @id @default(cuid())
  email         String         @unique
  pendingEmail  String?
  emailToken    String?
  passwordHash  String
  displayName   String
  photo         String?        // small data URL
  isAdmin       Boolean        @default(false) // server-wide, set once
  theme         String         @default("lilac")
  mode          String         @default("light")
  prefs         Json           @default("{}") // hero cards, notification choices, read alerts
  totpSecret    String?        // encrypted
  totpOn        Boolean        @default(false)
  recoveryCodes Json?          // hashed
  currentBusinessId String?
  memberships   Membership[]
  sessions      Session[]
  accountAccess AccountAccess[]
  channels      Channel[]
  createdAt     DateTime       @default(now())
}

model Session {
  id         String   @id // sha256 of the cookie token
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  userAgent  String?
  ip         String?
  pending2fa Boolean  @default(false)
  createdAt  DateTime @default(now())
  lastSeen   DateTime @default(now())
}

model Business {
  id            String       @id @default(cuid())
  name          String
  abn           String?
  gstRegistered Boolean      @default(false)
  gstPeriod     String       @default("quarterly") // quarterly | monthly
  memberships   Membership[]
  invites       Invite[]
  accounts      Account[]
  banks         Bank[]
  statements    Statement[]
  createdAt     DateTime     @default(now())
  deletedAt     DateTime?
}

model Membership {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  business    Business  @relation(fields: [businessId], references: [id])
  businessId  String
  role        Role      @default(VIEWER)
  joinedAt    DateTime  @default(now())
  removedAt   DateTime?

  @@unique([userId, businessId])
}

model Invite {
  id          String    @id @default(cuid())
  business    Business  @relation(fields: [businessId], references: [id])
  businessId  String
  token       String    @unique
  role        Role      @default(VIEWER)
  createdById String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
}

model Bank {
  id          String    @id @default(cuid())
  business    Business  @relation(fields: [businessId], references: [id])
  businessId  String
  name        String
  website     String?
  phone       String?
  email       String?
  note        String?
  icon        String?   // small data URL
  logo        String?
  accounts    Account[]
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  deletedById String?
}









model Account {
  id             String          @id @default(cuid())
  business       Business        @relation(fields: [businessId], references: [id])
  businessId     String
  bank           Bank            @relation(fields: [bankId], references: [id])
  bankId         String
  name           String
  type           String          @default("Transaction") // Transaction | Savings | Credit card
  openedAt       DateTime?
  bsb            String?         // encrypted
  number         String?         // encrypted
  nameOnAccount  String?
  openingBalance Decimal         @default(0) @db.Decimal(14, 2)
  openingDate    DateTime?
  access         AccountAccess[]
  statements     Statement[]
  createdAt      DateTime        @default(now())
  closedAt       DateTime?
  deletedAt      DateTime?
}

// Who can see an account. With no row, a member gets their role's default: owners always see every account,
// editors see accounts unless switched off, viewers see only accounts switched on for them (src/lib/server/access.ts).
model AccountAccess {
  account     Account  @relation(fields: [accountId], references: [id])
  accountId   String
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  allowed     Boolean
  changedAt   DateTime @default(now())
  changedById String?

  @@id([accountId, userId])
}

model Layout {
  id          String          @id @default(cuid())
  name        String
  bankName    String          // layouts are shared server-wide, so they key on the bank's name
  kind        String          // account (balance held) | card (balance owed)
  format      String          // PDF | CSV
  status      String          @default("ok") // ok | remap
  failedNote  String?
  versions    LayoutVersion[]
  createdAt   DateTime        @default(now())
  deletedAt   DateTime?
  deletedById String?
}

model LayoutVersion {
  id          String      @id @default(cuid())
  layout      Layout      @relation(fields: [layoutId], references: [id])
  layoutId    String
  version     Int
  map         Json        // PDF: { sectionId: { page, box:[x,y,w,h] } }; CSV: { cols:[role], dateFmt, header:[...] }
  fingerprint Json        // header words used to match statements
  createdBy   String
  createdAt   DateTime    @default(now())
  statements  Statement[]
}

model StoredFile {
  id        String      @id @default(cuid())
  name      String
  mime      String
  size      Int
  data      Bytes
  pending   Json?       // waiting for review or a layout: { businessId, userId, dest }
  createdAt DateTime    @default(now())
  statements Statement[]
}

model Statement {
  id              String         @id @default(cuid())
  business        Business       @relation(fields: [businessId], references: [id])
  businessId      String
  account         Account        @relation(fields: [accountId], references: [id])
  accountId       String
  periodStart     DateTime
  periodEnd       DateTime
  opening         Decimal        @db.Decimal(14, 2)
  closing         Decimal        @db.Decimal(14, 2)
  credits         Decimal        @default(0) @db.Decimal(14, 2)
  debits          Decimal        @default(0) @db.Decimal(14, 2)
  status          String         @default("Imported") // Reconciled | Imported | Needs attention
  statusNote      String?
  reviewedAt      DateTime?
  reviewNote      String?
  layoutVersion   LayoutVersion? @relation(fields: [layoutVersionId], references: [id])
  layoutVersionId String?
  file            StoredFile?    @relation(fields: [fileId], references: [id])
  fileId          String?
  pages           Int            @default(1)
  importedById    String?
  importedAt      DateTime       @default(now())
  txns            Txn[]
  deletedAt       DateTime?
  deletedById     String?
  deleteReason    String?
}

model Txn {
  id          String    @id @default(cuid())
  statement   Statement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  statementId String
  date        DateTime
  description String
  debit       Decimal   @default(0) @db.Decimal(14, 2)
  credit      Decimal   @default(0) @db.Decimal(14, 2)
  balance     Decimal?  @db.Decimal(14, 2)
  category    String?
  page        Int       @default(1)
  row         Int       @default(0)
  y           Float? // where the row sits on its page, % from the top
  yh          Float?
  dedupeKey   String
}

model Channel {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  service   String   // discord | telegram | ntfy | gotify | ha | webhook
  config    Json     // secrets encrypted
  amounts   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, service])
}

model ServerSetting {
  key   String @id
  value Json
}

model Backup {
  id        String   @id @default(cuid())
  fileName  String
  size      Int
  auto      Boolean  @default(true)
  createdAt DateTime @default(now())
}
